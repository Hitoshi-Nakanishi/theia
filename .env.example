# Copy this file to .env and adjust DATA_PATH for your machine.
# .env itself is gitignored.

# DATA_PATH is the root directory under which the default model archive lives.
#   Windows: typically a drive that holds the bulk data set
#     DATA_PATH=example-data
#   macOS / Linux / WSL:
#     DATA_PATH=$HOME/Documents/Theia/models

DATA_PATH=

# Expected default layout under DATA_PATH:
#   broker_models/
#     canonical/<source>/<analyst>/<ticker>.T_<name>.xlsx (+ optional .json/.arrow)
#                                       # labels shown in the viewer tree
